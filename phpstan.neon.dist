parameters:
    level: 7
    paths:
        - src
        - config
        - database
        - workbench
    # Compiled Blade is generated output rather than source. Analysing it
    # reports thousands of undefined variables from Filament's own view
    # internals, which no change here could fix.
    excludePaths:
        analyseAndScan:
            # Marked optional: the directory only exists once the workbench has
            # rendered a view, so a fresh CI checkout has no such path.
            - workbench/storage/framework/views (?)
    tmpDir: build/phpstan
    configDirectories:
        - config
